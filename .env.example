# Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ============================================================================
# Embedding Provider Selection
# ============================================================================
# Options: "openai" or "voyage"
EMBEDDING_PROVIDER=openai
EMBEDDING_DIMENSION=1536

# ============================================================================
# OpenAI Configuration (when EMBEDDING_PROVIDER=openai)
# ============================================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# ============================================================================
# Voyage AI Configuration (when EMBEDDING_PROVIDER=voyage)
# Anthropic recommended embedding provider
# Get API key from: https://dash.voyageai.com/
# ============================================================================
# VOYAGE_API_KEY=pa-your-api-key-here
# VOYAGE_EMBEDDING_MODEL=voyage-3
# VOYAGE_EMBEDDING_DIMENSION=1024

# Database (PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=catchup_feed
DB_USER=postgres
DB_PASSWORD=postgres

# gRPC Server
GRPC_HOST=0.0.0.0
GRPC_PORT=50051
GRPC_MAX_WORKERS=10
