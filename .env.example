# pulse-ai(src/pulse_transcribe + src/pulse_books)の環境変数一覧。
# 実行時はプロセス環境変数、またはこのファイルを .env にコピーしたものを
# pydantic-settings が読み込む(.env は gitignore 済み)。

# --- 必須 ---

# Pi の PostgreSQL(Tailscale 経由)。radio と完全に同じ値を共用する
# (実配置はポート 5433・DB 名 catchup-feed。deploy/ai.md 4章が正)。
DATABASE_URL=postgres://catchup-feed:CHANGE_ME@pi-hostname:5433/catchup-feed?sslmode=disable

# --- 任意(既定値あり)---

# faster-whisper のモデル(D-11: large-v3-turbo)。初回実行時に自動ダウンロード(無料)。
#WHISPER_MODEL=large-v3-turbo

# CTranslate2 のデバイスと計算精度。M3 Mac は CPU 実行(auto で可)。
# CPU で速度が足りないときは WHISPER_COMPUTE_TYPE=int8 を試す。
#WHISPER_DEVICE=auto
#WHISPER_COMPUTE_TYPE=auto

# D-14: 1夜に文字起こしする音源の合計上限(秒)。既定 7200 = 2時間。
# 超過分は翌夜に持ち越し。運用しながら調整してよい。
#NIGHTLY_BUDGET_SECONDS=7200

# jobs テーブルの poll 間隔(秒)。backend worker と同じ既定 10 秒。
#POLL_INTERVAL_SECONDS=10

# ログレベル(DEBUG / INFO / WARNING / ERROR)
#LOG_LEVEL=INFO

# --- 書籍 RAG 取り込み(pulse-books / book_ingest ジョブ)---

# D-25: ダッシュボード経由の書籍取り込み(kind='book_ingest')の PDF 取得元。
# Pi の tailnet 専用リスナー(backend compose.pi.yml の ${TAILNET_IP}:8081、
# 無認証 — tailnet バインドが境界、C-5)のベース URL。worker はここに
# /private/books/<ファイル名> を付けて PDF を一時取得する。
# 【設定すると】worker が kind='book_ingest' も消化するようになる。
# 【未設定なら】book_ingest ジョブは pending のまま残る(縮退動作)。
# D-14 の文字起こし予算は book_ingest には適用されない(embedding は数分の別種の仕事)。
#BOOKS_PRIVATE_BASE_URL=http://CHANGEME-pi.tailnet-name.ts.net:8081

# Ollama のエンドポイント。pulse-books(CLI・book_ingest ジョブとも)は
# Mac ローカルで実行するので既定の localhost でよい(C-12: 書籍データはローカル限定)。
#OLLAMA_HOST=http://localhost:11434

# embedding モデル(D-12: bge-m3、1024次元)。変更する場合も 1024 次元必須
# (book_chunks は vector(1024))+全書籍の再取り込みが必要。
#EMBEDDING_MODEL=bge-m3

# --- テスト専用 ---

# 実 Postgres 統合テストのゲート(backend と同じ流儀)。未設定なら該当テストは skip。
# テストは専用スキーマ(pulse_transcribe_it / pulse_books_it)を作って使うため、
# 開発用 DB を指してよい。書籍 RAG のテストは pgvector 拡張が必要
# (pgvector/pgvector:pg18 コンテナ推奨)。
#TEST_DATABASE_URL=postgresql://localhost:5432/pulse_test

# 実行時間ガード(--deadline HH:MM、既定 04:15)は環境変数ではなく CLI 引数。
# 例: uv run pulse-transcribe --deadline 04:15
