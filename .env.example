# pulse transcribe worker(src/pulse_transcribe)の環境変数一覧。
# 実行時はプロセス環境変数、またはこのファイルを .env にコピーしたものを
# pydantic-settings が読み込む(.env は gitignore 済み)。

# --- 必須 ---

# Pi の PostgreSQL(Tailscale 経由)。radio と同じ DSN 方式。
DATABASE_URL=postgresql://pulse:CHANGE_ME@pi-hostname:5432/pulse

# --- 任意(既定値あり)---

# faster-whisper のモデル(D-11: large-v3-turbo)。初回実行時に自動ダウンロード(無料)。
#WHISPER_MODEL=large-v3-turbo

# CTranslate2 のデバイスと計算精度。M3 Mac は CPU 実行(auto で可)。
# CPU で速度が足りないときは WHISPER_COMPUTE_TYPE=int8 を試す。
#WHISPER_DEVICE=auto
#WHISPER_COMPUTE_TYPE=auto

# D-14: 1夜に文字起こしする音源の合計上限(秒)。既定 7200 = 2時間。
# 超過分は翌夜に持ち越し。運用しながら調整してよい。
#NIGHTLY_BUDGET_SECONDS=7200

# jobs テーブルの poll 間隔(秒)。backend worker と同じ既定 10 秒。
#POLL_INTERVAL_SECONDS=10

# ログレベル(DEBUG / INFO / WARNING / ERROR)
#LOG_LEVEL=INFO

# --- テスト専用 ---

# 実 Postgres 統合テストのゲート(backend と同じ流儀)。未設定なら該当テストは skip。
# テストは専用スキーマ(pulse_transcribe_it)を作って使うため、開発用 DB を指してよい。
#TEST_DATABASE_URL=postgresql://localhost:5432/pulse_test

# 実行時間ガード(--deadline HH:MM、既定 04:15)は環境変数ではなく CLI 引数。
# 例: uv run pulse-transcribe --deadline 04:15
