# ===========================================
# catchup-ai Environment Variables
# ===========================================

# --- Embedding Provider ---
# Options: openai, voyage
EMBEDDING_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-xxx

# --- Anthropic (optional, if using anthropic for RAG) ---
# ANTHROPIC_API_KEY=sk-ant-xxx

# --- Voyage (optional) ---
VOYAGE_API_KEY=pa-xxx

# --- gRPC Server ---
GRPC_PORT=50053

# --- Backend Connection ---
# Local development
BACKEND_GRPC_HOST=localhost
BACKEND_GRPC_PORT=50052
BACKEND_GRPC_TLS=false

# Production (Cloud Run → Tailscale → RPi5)
# BACKEND_GRPC_HOST=100.x.x.x  # RPi5's Tailscale IP
# BACKEND_GRPC_PORT=50052
# BACKEND_GRPC_TLS=false  # WireGuard handles encryption

# --- LLM Provider (for RAG) ---
# Options: anthropic, openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-5-mini
